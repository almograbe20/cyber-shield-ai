# Cyber Shield AI — environment variables
# ملف مثال: انسخه إلى ".env" وضع مفتاحك الحقيقي هناك (ملف .env غير مرفوع على Git).
#
#   cp .env.example .env     (أو انسخه يدوياً)
#   ثم عدّل القيمة التالية:

# مفتاح Claude API — عند ضبطه يتحوّل الموقع تلقائياً من التحليل المحلي إلى Claude API.
# احصل عليه من: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (اختياري) اسم النموذج المستخدم في التحليل
# ANTHROPIC_MODEL=claude-opus-4-8

# حماية SSRF: السماح بفحص localhost. اتركها 1 للتطوير، واجعلها 0 في الإنتاج
# لمنع فحص عناوين الجهاز الداخلية.
# CYBERSHIELD_ALLOW_LOCALHOST=1
